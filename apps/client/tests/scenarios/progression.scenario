# SPDX-License-Identifier: GPL-3.0-or-later
# Progression and crafting (docs/specs/scenario-feed.md §6.6): experience, skills learned
# and forgotten, a trainer, trait points and slots, a profession, recipes, a crafting bar
# and its result, reputation and a title. Synthetic: literal refs play without an install;
# with one, the skill, recipe and title selectors add records.
tessera-scenario 1
title "Workshop lessons"
tick 100ms
player "Tamsin"
select $lessons = skill monster=no harmful=no n=3 seed=13
select $plans = recipe n=2 seed=17
select $honours = title n=1 seed=4
actor $mentor kind=npc name="Mentor" pos=0,2,0
item $stool "Simple stool"

at 0s spawn $mentor
+0s xp 1200/5000
+0s trait-points 2/4
+0s learn "Mend tools"
+0s learn $lessons
+0.5s trainer skills="Plane wood","Join timber","Carve trim" npc=$mentor coin=100,150,300 level=1,5,10

on train entry=1
+0s learn "Plane wood"
+0s xp 1400/5000
end
on slot-trait
+0s trait 0 "Patient hands" rank=1
+0s trait-points 1/4
end
on craft
+0s cast player "Simple stool" 2s kind=craft
+2s give $stool
+0s craft-result "Simple stool" success item=$stool
+0s xp 1900/5000
end

at 2s close trainer
+0s profession "Woodworking" tier=1 proficiency=40/200 mastery=0/100
+0.5s recipe "Simple stool"
+0s recipe $plans
+5s profession "Woodworking" tier=1 proficiency=65/200 mastery=5/100
+0.5s reputation "Carpenters hall" 1500 tier=2
+0.5s title "Apprentice joiner"
+0s title $honours[0]
+0.5s forget "Mend tools"
+0.5s trait 0 none
+0s trait-points 2/4
+0.5s xp 5000/5000

input
at 1s train 1
at 1.5s slot-trait 0 "Patient hands"
at 3s craft "Simple stool" qty=1
end
