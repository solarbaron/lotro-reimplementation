# Syntax tokens of object-state records (docs/specs/wstate.md): item markers, the null
# reference, native class indices (u16 LE) and the scene-entry sentinel. No game data.
marker_object="\x00\x00\x00\x00"
marker_did="\x00\x00\x00\x20"
marker_native="\x00\x00\x00\x10"
marker_instance="\x00\x00\x00\x08"
null_ref="\xff\xff\xff\xff"
class_map="\x0b\x00"
class_refmap="\x23\x00"
class_array="\x19\x00"
class_refarray="\xb0\x00"
class_set="\x12\x00"
class_property="\x27\x00"
class_property_set="\xa6\x00"
class_position="\xa0\x00"
class_string_info="\xc7\x00"
class_string="\xe1\x00"
class_scene="\xab\x01"
class_barter="\x96\x07"
class_options="\x9f\x01"
class_quest_targets="\xaf\x09"
scene_sentinel="\xfc\xfc\xfc\xfc"
did_prefix="\x00\x00\x00\x70"
reserved="\x00\x00\x01"
