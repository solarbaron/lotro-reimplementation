# Syntax tokens of Tessera's own keymap format (docs/specs/keymap.md); no game data.
"format = \"tessera-keymap\""
"version = "
"[options]"
"sequence_timeout_ms = "
"[bindings."
"]"
" = ["
"{ input = "
"{ axis = "
", value = "
", scale = "
", deadzone = "
", invert = true"
"\""
"+"
" "
"Ctrl+"
"Shift+"
"Alt+"
"Super+"
"Shift"
"W"
"Space"
"Escape"
"LShift"
"MouseLeft"
"MouseRight"
"Mouse7"
"WheelUp"
"PadSouth"
"PadLeftY"
"MouseX"
"WheelY"
"movement"
"move_forward"
"jump"
"\"ui.dialog\""
